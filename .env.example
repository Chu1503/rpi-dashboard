# Personalization
DISPLAY_NAME=Chu

# Open-Meteo location (decimal latitude/longitude)
WEATHER_LAT=
WEATHER_LON=

# Listen on the LAN for the protected phone remote. Non-remote dashboard routes
# remain restricted to the UNO Q itself by app.py.
ALFRED_HOST=0.0.0.0
ALFRED_PORT=8080

# IANA timezone used for calendar times and day grouping. This is independent
# of the UNO's Linux timezone and automatically observes daylight saving time.
DASHBOARD_TIME_ZONE=America/Chicago

# Required for TV power control. Use a private 12+ character value.
TV_REMOTE_TOKEN=replace-with-a-private-access-key
TV_BRIDGE_SOCKET=/var/run/arduino-router.sock
TV_RPC_TIMEOUT_SECONDS=3

# Optional Google Calendar selection
GOOGLE_CALENDAR_ID=primary
CALENDAR_DAYS=14

# On-screen limits
MAX_TASKS=14
MAX_EVENTS=8

# Cache durations in seconds
CALENDAR_CACHE_SECONDS=60
TASKS_CACHE_SECONDS=60
WEATHER_CACHE_SECONDS=600
HEALTH_CACHE_SECONDS=600
STEPS_CACHE_SECONDS=120
HEART_RATE_CACHE_SECONDS=120
EXTERNAL_REQUEST_TIMEOUT_SECONDS=12

# Local British voice. Speaker 2 is the deeper "Obadiah" voice in this model.
ALFRED_PIPER_MODEL=data/voices/en_GB-semaine-medium.onnx
ALFRED_PIPER_SPEAKER=2

# Free online neural voice. Reply text is sent to Microsoft's Edge speech
# service, then converted to a TV-friendly WAV locally. Piper above remains
# the automatic offline/private fallback.
ALFRED_TTS_VOICE=en-GB-RyanNeural
ALFRED_TTS_RATE=+5%
ALFRED_TTS_VOLUME=+0%
ALFRED_TTS_PITCH=+0Hz

# Optional always-on USB microphone. On the UNO, the deployment script enables
# this and downloads the small offline English Vosk model. Leave MIC_DEVICE
# blank to automatically select the first actual USB capture card.
ALFRED_VOICE_INPUT_ENABLED=false
ALFRED_MIC_DEVICE=
ALFRED_WAKE_WORD=Alfred
ALFRED_WAKE_WORDS=Alfred,Computer,Jarvis
ALFRED_WAKE_ALIASES=Alfred,Alford,Fred,Computer,Jarvis,Jervis
ALFRED_VOICE_SAMPLE_RATE=16000
ALFRED_VOSK_MODEL=data/voices/vosk-model-small-en-us-0.15

# Visual testing only. Keep false for real use.
ALFRED_DEMO_MODE=false
