<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alfred_red"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="54dp"
            android:paddingTop="30dp"
            android:paddingEnd="54dp"
            android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/alfredTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.22"
                    android:text="ALFRED"
                    android:textColor="@color/alfred_red"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Not connected"
                    android:textColor="@color/alfred_red"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="top|end"
                android:background="@drawable/refresh_button"
                android:contentDescription="@string/refresh_dashboard"
                android:padding="12dp"
                android:src="@drawable/ic_refresh" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/powerButton"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="54dp"
            android:background="@drawable/power_button"
            android:contentDescription="@string/toggle_tv_power"
            android:padding="27dp"
            android:src="@drawable/ic_power" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="26dp"
            android:background="@drawable/mic_button"
            android:contentDescription="@string/microphone"
            android:padding="29dp"
            android:src="@drawable/ic_mic" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/hdmi1Button"
                android:layout_width="88dp"
                android:layout_height="48dp"
                android:text="HDMI 1"
                android:textColor="@color/ink"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/hdmi2Button"
                android:layout_width="88dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="HDMI 2"
                android:textColor="@color/ink"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/answerText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_horizontal"
            android:textColor="@color/alfred_red"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/queryInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/input_background"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/send_button"
                android:contentDescription="@string/send"
                android:padding="16dp"
                android:src="@drawable/ic_send" />
        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="210dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">
            <Button
                android:id="@+id/volumeUpButton"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:background="@drawable/refresh_button"
                android:text="+"
                android:textColor="@color/ink"
                android:textSize="30sp"
                android:contentDescription="Volume up" />
            <Button
                android:id="@+id/volumeDownButton"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/refresh_button"
                android:text="−"
                android:textColor="@color/ink"
                android:textSize="30sp"
                android:contentDescription="Volume down" />
        </LinearLayout>

        <com.alfred.remote.VerticalSeekBar
            android:id="@+id/scrollControl"
            android:layout_width="42dp"
            android:layout_height="210dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:background="@drawable/scroll_container"
            android:contentDescription="@string/scroll_dashboard"
            android:max="100"
            android:padding="6dp"
            android:progress="0"
            android:progressDrawable="@drawable/scroll_track"
            android:splitTrack="false"
            android:thumb="@drawable/scroll_thumb" />
    </FrameLayout>
</LinearLayout>
