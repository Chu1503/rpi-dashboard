<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:top="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#A9AAA6" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:top="7dp" android:bottom="7dp">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#A9AAA6" />
            </shape>
        </clip>
    </item>
</layer-list>
