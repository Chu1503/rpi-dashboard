<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval"><solid android:color="@color/ink" /><stroke android:width="2dp" android:color="@color/alfred_red" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#7E1724" /><stroke android:width="2dp" android:color="@color/ink" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@color/alfred_red" /><stroke android:width="2dp" android:color="@color/ink" /></shape>
    </item>
</selector>
