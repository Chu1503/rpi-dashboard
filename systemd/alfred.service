[Unit]
Description=Alfred Dashboard Backend
After=network-online.target arduino-router.service
Wants=network-online.target

[Service]
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/home/arduino/Alfred
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/arduino/Alfred/.venv/bin/python -m waitress --listen=0.0.0.0:8080 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
